#!/bin/bash
# cy-restart - request a controlled Cy runner restart WITHOUT Administrator
# privileges.
#
# This writes a small, narrowly-scoped marker file
# (runner/state/restart-request.json) into a directory the normal user
# session already owns. It performs NO privileged action itself - it never
# stops or starts anything.
#
# The Cy Runner Watchdog scheduled task (already running as SYSTEM, once per
# minute, installed by install-watchdog-task.ps1) is the ONLY thing that ever
# acts on this file. On its next tick (within ~60s) it will:
#   - identify the Cy runner it actually owns (same strict
#     node.exe + '*runner*run.js*' command-line match the watchdog already
#     uses for its own stale-heartbeat recovery - never an arbitrary node.exe)
#   - stop that process
#   - let the existing supervisor loop (cy-supervisor.bat) start exactly one
#     replacement runner after its normal 15s delay
#   - clear the request file and log the whole sequence to
#     runner/state/watchdog.log
#
# A request older than 5 minutes when the watchdog sees it is treated as
# stale and cleared WITHOUT restarting anything, so a leftover file (e.g.
# surviving a reboot) can never cause a restart loop.
#
# Usage:
#   ./cy-restart                      # generic request
#   ./cy-restart "deploy: fix XYZ"     # request with a reason (recommended)
#
# Check runner/state/watchdog.log afterwards to confirm the restart happened.

set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
STATE_DIR="$HERE/state"
REQUEST_PATH="$STATE_DIR/restart-request.json"
REASON="${1:-manual restart request}"

if [ ! -d "$STATE_DIR" ]; then
  echo "cy-restart: state directory not found: $STATE_DIR" >&2
  exit 1
fi

REQUESTED_BY="${USER:-${USERNAME:-unknown}}"

# DELL WSL's uutils date 0.8.0 expands %s%3N to nanoseconds, not the
# milliseconds expected by the watchdog. Generate both timestamps from one
# clock reading and let JSON encode arbitrary reason text safely.
python3 - "$REQUEST_PATH" "$REASON" "$REQUESTED_BY" <<'PY'
import datetime
import json
import os
import sys
import tempfile
import time

path, reason, requested_by = sys.argv[1:]
now_ms = time.time_ns() // 1_000_000
seconds, milliseconds = divmod(now_ms, 1000)
requested_at = datetime.datetime.fromtimestamp(seconds, datetime.timezone.utc)
requested_at = requested_at.replace(microsecond=milliseconds * 1000)
request = {
    "schema": "cy.restart-request",
    "version": 1,
    "requestedAtMs": now_ms,
    "requestedAt": requested_at.isoformat(timespec="milliseconds").replace("+00:00", "Z"),
    "reason": reason,
    "requestedBy": requested_by,
}
fd, temporary = tempfile.mkstemp(prefix=".restart-request-", suffix=".tmp",
                              dir=os.path.dirname(path))
try:
    with os.fdopen(fd, "w", encoding="utf-8") as output:
        json.dump(request, output, ensure_ascii=True, indent=2)
        output.write("\n")
    os.replace(temporary, path)
finally:
    if os.path.exists(temporary):
        os.unlink(temporary)
PY

echo "cy-restart: restart requested ($REQUEST_PATH)"
echo "cy-restart: the Cy Runner Watchdog (SYSTEM, runs every ~60s) will action this automatically."
echo "cy-restart: check runner/state/watchdog.log to confirm."
